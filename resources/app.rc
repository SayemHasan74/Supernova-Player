#include <windows.h>

#define IDI_APP_ICON 101

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Supernova Project"
            VALUE "FileDescription", "Supernova Media Player"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "Supernova"
            VALUE "OriginalFilename", "Supernova.exe"
            VALUE "ProductName", "Supernova"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDI_APP_ICON ICON "icons/supernova.ico"
